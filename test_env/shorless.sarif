          ]
        },
        {
          "ruleId": "SHORLESS-CODE-C-NET",
          "level": "warning",
          "message": {
            "text": "[ÉLEVÉ] Hachage .NET SHA-1 / MD5 Obsolète — Détecté : using var sha1 = SHA1.Create(); | Remédiation : Remplacer par SHA256.Create() ou SHA3_256.Create()."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "test_env/AuthController.cs"
