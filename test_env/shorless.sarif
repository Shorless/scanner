{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "0.9.8",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Shorless PQC & CBOM Scanner",
          "informationUri": "https://shorless.io",
          "version": "0.9.8",
          "rules": [
            {
              "id": "SHORLESS-CODE-PYTHON-AST",
              "name": "Code Python (AST)",
              "shortDescription": {
                "text": "Risque Post-Quantique (Code Python (AST))"
              },
              "fullDescription": {
                "text": "Détection d'algorithmes, de dépendances ou de configurations TLS vulnérables à l'algorithme de Shor ou Grover."
              },
              "help": {
                "text": "Migrer vers une approche hybride (ex: X25519 + ML-KEM-768) ou signatures ML-DSA."
              },
              "properties": {
                "tags": [
                  "security",
                  "post-quantum",
                  "cryptography",
                  "cbom",
                  "nis2"
                ]
              }
            },
            {
              "id": "SHORLESS-CODE-JAVA-JCA",
              "name": "Code Java (JCA)",
              "shortDescription": {
                "text": "Risque Post-Quantique (Code Java (JCA))"
              },
              "fullDescription": {
                "text": "Détection d'algorithmes, de dépendances ou de configurations TLS vulnérables à l'algorithme de Shor ou Grover."
              },
              "help": {
                "text": "Utiliser BouncyCastle PQC (bcprov-jdk18on 1.78+) avec ML-KEM (Kyber) ou ML-DSA (Dilithium)."
              },
              "properties": {
                "tags": [
                  "security",
                  "post-quantum",
                  "cryptography",
                  "cbom",
                  "nis2"
                ]
              }
            },
            {
              "id": "SHORLESS-CODE-GO-STDLIB",
              "name": "Code Go (Stdlib)",
              "shortDescription": {
                "text": "Risque Post-Quantique (Code Go (Stdlib))"
              },
              "fullDescription": {
                "text": "Détection d'algorithmes, de dépendances ou de configurations TLS vulnérables à l'algorithme de Shor ou Grover."
              },
              "help": {
                "text": "Migrer vers crypto/mlkem (Go 1.24+) ou cloudflare/circl pour l'encapsulation hybride X25519MLKEM768."
              },
              "properties": {
                "tags": [
                  "security",
                  "post-quantum",
                  "cryptography",
                  "cbom",
                  "nis2"
                ]
              }
            },
            {
              "id": "SHORLESS-CODE-NODE-JS-TS",
              "name": "Code Node.js / TS",
              "shortDescription": {
                "text": "Risque Post-Quantique (Code Node.js / TS)"
              },
              "fullDescription": {
                "text": "Détection d'algorithmes, de dépendances ou de configurations TLS vulnérables à l'algorithme de Shor ou Grover."
              },
              "help": {
                "text": "Migrer vers un binding liboqs / OpenSSL 3.2+ ou WebCrypto supportant ML-KEM (FIPS 203) et ML-DSA (FIPS 204)."
              },
              "properties": {
                "tags": [
                  "security",
                  "post-quantum",
                  "cryptography",
                  "cbom",
                  "nis2"
                ]
              }
            },
            {
              "id": "SHORLESS-CODE-C-NET",
              "name": "Code C# (.NET)",
              "shortDescription": {
                "text": "Risque Post-Quantique (Code C# (.NET))"
              },
              "fullDescription": {
                "text": "Détection d'algorithmes, de dépendances ou de configurations TLS vulnérables à l'algorithme de Shor ou Grover."
              },
              "help": {
                "text": "Migrer vers System.Security.Cryptography.MLKem / MLDsa (.NET 9+) ou BouncyCastle.Cryptography PQC."
              },
              "properties": {
                "tags": [
                  "security",
                  "post-quantum",
                  "cryptography",
                  "cbom",
                  "nis2"
                ]
              }
            },
            {
              "id": "SHORLESS-INFRA-NGINX",
              "name": "Infra (Nginx)",
              "shortDescription": {
                "text": "Risque Post-Quantique (Infra (Nginx))"
              },
              "fullDescription": {
                "text": "Détection d'algorithmes, de dépendances ou de configurations TLS vulnérables à l'algorithme de Shor ou Grover."
              },
              "help": {
                "text": "Activer TLSv1.3 (prérequis obligatoire pour l'échange de clés post-quantique ML-KEM)."
              },
              "properties": {
                "tags": [
                  "security",
                  "post-quantum",
                  "cryptography",
                  "cbom",
                  "nis2"
                ]
              }
            },
            {
              "id": "SHORLESS-H-RITAGE-RUNTIME-NET",
              "name": "Héritage Runtime (.NET)",
              "shortDescription": {
                "text": "Risque Post-Quantique (Héritage Runtime (.NET))"
              },
              "fullDescription": {
                "text": "Détection d'algorithmes, de dépendances ou de configurations TLS vulnérables à l'algorithme de Shor ou Grover."
              },
              "help": {
                "text": "Migrer vers <TargetFramework>net9.0</TargetFramework> (System.Security.Cryptography.MLKem) ou ajouter BouncyCastle.Cryptography >= 2.4.0."
              },
              "properties": {
                "tags": [
                  "security",
                  "post-quantum",
                  "cryptography",
                  "cbom",
                  "nis2"
                ]
              }
            },
            {
              "id": "SHORLESS-D-PENDANCE-SCA-NUGET-C",
              "name": "Dépendance SCA (NuGet C#)",
              "shortDescription": {
                "text": "Risque Post-Quantique (Dépendance SCA (NuGet C#))"
              },
              "fullDescription": {
                "text": "Détection d'algorithmes, de dépendances ou de configurations TLS vulnérables à l'algorithme de Shor ou Grover."
              },
              "help": {
                "text": "Remplacer par le package officiel 'BouncyCastle.Cryptography' (version >= 2.4.0) supportant ML-KEM et ML-DSA."
              },
              "properties": {
                "tags": [
                  "security",
                  "post-quantum",
                  "cryptography",
                  "cbom",
                  "nis2"
                ]
              }
            },
            {
              "id": "SHORLESS-CONTENEUR-DOCKER",
              "name": "Conteneur (Docker)",
              "shortDescription": {
                "text": "Risque Post-Quantique (Conteneur (Docker))"
              },
              "fullDescription": {
                "text": "Détection d'algorithmes, de dépendances ou de configurations TLS vulnérables à l'algorithme de Shor ou Grover."
              },
              "help": {
                "text": "Migrer vers une image de base récente (ex: bookworm/trixie, ubuntu:24.04, alpine:3.20+, node:22, dotnet:9.0) embarquant OpenSSL 3.2+."
              },
              "properties": {
                "tags": [
                  "security",
                  "post-quantum",
                  "cryptography",
                  "cbom",
                  "nis2"
                ]
              }
            },
            {
              "id": "SHORLESS-CERTIFICAT-X-509-PKI",
              "name": "Certificat X.509 (PKI)",
              "shortDescription": {
                "text": "Risque Post-Quantique (Certificat X.509 (PKI))"
              },
              "fullDescription": {
                "text": "Détection d'algorithmes, de dépendances ou de configurations TLS vulnérables à l'algorithme de Shor ou Grover."
              },
              "help": {
                "text": "Inventorié dans le CBOM. Vérifier la date d'expiration et préparer la migration vers des certificats hybrides ou ML-DSA (FIPS 204)."
              },
              "properties": {
                "tags": [
                  "security",
                  "post-quantum",
                  "cryptography",
                  "cbom",
                  "nis2"
                ]
              }
            },
            {
              "id": "SHORLESS-D-PENDANCE-SCA-PYTHON",
              "name": "Dépendance SCA (Python)",
              "shortDescription": {
                "text": "Risque Post-Quantique (Dépendance SCA (Python))"
              },
              "fullDescription": {
                "text": "Détection d'algorithmes, de dépendances ou de configurations TLS vulnérables à l'algorithme de Shor ou Grover."
              },
              "help": {
                "text": "Mettre à niveau vers cryptography>=42.0.0 (OpenSSL 3.2+ compatible ML-KEM)."
              },
              "properties": {
                "tags": [
                  "security",
                  "post-quantum",
                  "cryptography",
                  "cbom",
                  "nis2"
                ]
              }
            },
            {
              "id": "SHORLESS-INFRA-TRAEFIK",
              "name": "Infra (Traefik)",
              "shortDescription": {
                "text": "Risque Post-Quantique (Infra (Traefik))"
              },
              "fullDescription": {
                "text": "Détection d'algorithmes, de dépendances ou de configurations TLS vulnérables à l'algorithme de Shor ou Grover."
              },
              "help": {
                "text": "Définir 'minVersion: VersionTLS13' dans tls.options de Traefik."
              },
              "properties": {
                "tags": [
                  "security",
                  "post-quantum",
                  "cryptography",
                  "cbom",
                  "nis2"
                ]
              }
            },
            {
              "id": "SHORLESS-INFRA-K8S-INGRESS",
              "name": "Infra (K8s Ingress)",
              "shortDescription": {
                "text": "Risque Post-Quantique (Infra (K8s Ingress))"
              },
              "fullDescription": {
                "text": "Détection d'algorithmes, de dépendances ou de configurations TLS vulnérables à l'algorithme de Shor ou Grover."
              },
              "help": {
                "text": "Forcer 'nginx.ingress.kubernetes.io/ssl-protocols: \"TLSv1.3\"'."
              },
              "properties": {
                "tags": [
                  "security",
                  "post-quantum",
                  "cryptography",
                  "cbom",
                  "nis2"
                ]
              }
            },
            {
              "id": "SHORLESS-IAC-TERRAFORM",
              "name": "IaC (Terraform)",
              "shortDescription": {
                "text": "Risque Post-Quantique (IaC (Terraform))"
              },
              "fullDescription": {
                "text": "Détection d'algorithmes, de dépendances ou de configurations TLS vulnérables à l'algorithme de Shor ou Grover."
              },
              "help": {
                "text": "Remplacer les clés statiques RSA/ECDSA par des mécanismes d'encapsulation hybrides (ML-KEM) ou signatures ML-DSA."
              },
              "properties": {
                "tags": [
                  "security",
                  "post-quantum",
                  "cryptography",
                  "cbom",
                  "nis2"
                ]
              }
            },
            {
              "id": "SHORLESS-MODULE-IAC-TERRAFORM",
              "name": "Module IaC (Terraform)",
              "shortDescription": {
                "text": "Risque Post-Quantique (Module IaC (Terraform))"
              },
              "fullDescription": {
                "text": "Détection d'algorithmes, de dépendances ou de configurations TLS vulnérables à l'algorithme de Shor ou Grover."
              },
              "help": {
                "text": "Surcharger explicitement 'ssl_policy = \"ELBSecurityPolicy-TLS13-1-2-2021-06\"' (ou équivalent TLS 1.3 PQC) dans les paramètres du module."
              },
              "properties": {
                "tags": [
                  "security",
                  "post-quantum",
                  "cryptography",
                  "cbom",
                  "nis2"
                ]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "SHORLESS-CODE-PYTHON-AST",
          "level": "error",
          "message": {
            "text": "[CRITIQUE] RSA / ECC (Asymétrique) — Détecté : generate_private_key | Remédiation : Migrer vers une approche hybride (ex: X25519 + ML-KEM-768) ou signatures ML-DSA."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "test_env/auth_service.py"
                },
                "region": {
                  "startLine": 2
                }
              }
            }
          ]
        },
        {
          "ruleId": "SHORLESS-CODE-PYTHON-AST",
          "level": "error",
          "message": {
            "text": "[CRITIQUE] ECDSA / ECDH (P-256) — Détecté : SECP256R1 | Remédiation : Utiliser liboqs / OpenSSL 3.2+ avec un provider OQS pour hybrider la courbe."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "test_env/auth_service.py"
                },
                "region": {
                  "startLine": 3
                }
              }
            }
          ]
        },
        {
          "ruleId": "SHORLESS-CODE-JAVA-JCA",
          "level": "error",
          "message": {
            "text": "[CRITIQUE] Java KeyPairGenerator RSA/ECC (Vulnérable à Shor) — Détecté : KeyPairGenerator kpg = KeyPairGenerator.getInstance(\"RSA\"); | Remédiation : Utiliser BouncyCastle PQC (bcprov-jdk18on 1.78+) avec ML-KEM (Kyber) ou ML-DSA (Dilithium)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "test_env/CryptoService.java"
                },
                "region": {
                  "startLine": 4
                }
              }
            }
          ]
        },
        {
          "ruleId": "SHORLESS-CODE-GO-STDLIB",
          "level": "error",
          "message": {
            "text": "[CRITIQUE] Go crypto/rsa ou crypto/ecdsa (Vulnérable à Shor) — Détecté : func gen() { _, _ = rsa.GenerateKey(rand.Reader, 2048) } | Remédiation : Migrer vers crypto/mlkem (Go 1.24+) ou cloudflare/circl pour l'encapsulation hybride X25519MLKEM768."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "test_env/tls_auth.go"
                },
                "region": {
                  "startLine": 3
                }
              }
            }
          ]
        },
        {
          "ruleId": "SHORLESS-CODE-NODE-JS-TS",
          "level": "error",
          "message": {
            "text": "[CRITIQUE] Node.js crypto RSA / ECDSA (Vulnérable à Shor) — Détecté : const { privateKey } = crypto.generateKeyPairSync('rsa', { modulusLength: 2048 }); | Remédiation : Migrer vers un binding liboqs / OpenSSL 3.2+ ou WebCrypto supportant ML-KEM (FIPS 203) et ML-DSA (FIPS 204)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "test_env/jwt_signer.js"
                },
                "region": {
                  "startLine": 2
                }
              }
            }
          ]
        },
        {
          "ruleId": "SHORLESS-CODE-NODE-JS-TS",
          "level": "warning",
          "message": {
            "text": "[ÉLEVÉ] Hachage Node.js SHA-1 / MD5 Obsolète — Détecté : const hash = crypto.createHash('md5').update('token').digest('hex'); | Remédiation : Utiliser crypto.createHash('sha256') ou 'sha3-256'."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "test_env/jwt_signer.js"
                },
                "region": {
                  "startLine": 3
                }
              }
            }
          ]
        },
        {
          "ruleId": "SHORLESS-CODE-NODE-JS-TS",
          "level": "error",
          "message": {
            "text": "[CRITIQUE] Node.js crypto RSA / ECDSA (Vulnérable à Shor) — Détecté : export const kp = crypto.generateKeyPairSync('ec', { namedCurve: 'prime256v1' }); | Remédiation : Migrer vers un binding liboqs / OpenSSL 3.2+ ou WebCrypto supportant ML-KEM (FIPS 203) et ML-DSA (FIPS 204)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "test_env/token_service.ts"
                },
                "region": {
                  "startLine": 2
                }
              }
            }
          ]
        },
        {
          "ruleId": "SHORLESS-CODE-C-NET",
          "level": "error",
          "message": {
            "text": "[CRITIQUE] .NET RSA / ECDsa Asymétrique Classique (Vulnérable à Shor) — Détecté : using var rsa = RSA.Create(2048); | Remédiation : Migrer vers System.Security.Cryptography.MLKem / MLDsa (.NET 9+) ou BouncyCastle.Cryptography PQC."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
