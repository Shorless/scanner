          "level": "note",
          "message": {
            "text": "[MOYEN] Échange de clés ECDHE classique — Détecté : Absence de courbe hybride PQC | Remédiation : Ajouter 'ssl_ecdh_curve X25519MLKEM768:X25519;' (Supporté dès OpenSSL 3.2+ / Nginx récent)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "test_env/nginx.conf"
