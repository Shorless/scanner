          "ruleId": "SHORLESS-INFRA-NGINX",
          "level": "error",
          "message": {
            "text": "[CRITIQUE] TLS < 1.3 — Détecté : ssl_protocols TLSv1.2 TLSv1.3; | Remédiation : Activer TLSv1.3 (prérequis obligatoire pour l'échange de clés post-quantique ML-KEM)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "test_env/nginx.conf"
                },
                "region": {
                  "startLine": 3
